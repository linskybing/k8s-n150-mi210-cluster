                            "set -e\nsource $PYTHON_ENV_DIR/bin/activate\n# first run (~1 min): build SGLang's CPU kernels (sgl-kernel) against the image's torch, + torchao, into ~/venvs/sglang-tt\n[ -e ~/venvs/sglang-tt/sgl_kernel ] || (pip install -q --target ~/venvs/sglang-tt-build scikit-build-core cmake ninja \\\n  \u0026\u0026 cd ~/tt-sglang/sgl-kernel \u0026\u0026 cp pyproject_cpu.toml pyproject.toml \\\n  \u0026\u0026 PATH=~/venvs/sglang-tt-build/bin:$PATH PYTHONPATH=~/venvs/sglang-tt-build:$PYTHONPATH MAX_JOBS=8 \\\n     pip install -q --no-build-isolation --no-deps --target ~/venvs/sglang-tt . torchao==0.9.0)\nexport PYTHONPATH=/sglang-site:$HOME/tt-sglang/python:$HOME/tt-inference-server/tt-sglang-plugin:$HOME/venvs/sglang-tt:$PYTHONPATH\nexport SGLANG_TT_SITE=1   # /sglang-site/sitecustomize.py: decode alias + TT plugin in every process\nexec python -c 'from sglang_tt_plugin.scripts.launch_tt_server import main; main()' --model-path meta-llama/Llama-3.2-1B-Instruct --port 8000 --context-length 8192 --enable-metrics --max-total-tokens 131072\n"
