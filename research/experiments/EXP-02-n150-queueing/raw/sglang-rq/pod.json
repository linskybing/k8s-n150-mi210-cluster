    "spec": {
        "containers": [
            {
                "args": [
                    "set -e\nsource $PYTHON_ENV_DIR/bin/activate\n# first run (~1 min): build SGLang's CPU kernels (sgl-kernel) against the image's torch, + torchao, into ~/venvs/sglang-tt\n[ -e ~/venvs/sglang-tt/sgl_kernel ] || (pip install -q --target ~/venvs/sglang-tt-build scikit-build-core cmake ninja \\\n  \u0026\u0026 cd ~/tt-sglang/sgl-kernel \u0026\u0026 cp pyproject_cpu.toml pyproject.toml \\\n  \u0026\u0026 PATH=~/venvs/sglang-tt-build/bin:$PATH PYTHONPATH=~/venvs/sglang-tt-build:$PYTHONPATH MAX_JOBS=8 \\\n     pip install -q --no-build-isolation --no-deps --target ~/venvs/sglang-tt . torchao==0.9.0)\nexport PYTHONPATH=$HOME/tt-sglang/python:$HOME/tt-inference-server/tt-sglang-plugin:$HOME/venvs/sglang-tt:$PYTHONPATH\n# the image's tt-metal (84b4c53) calls Generator.decode_forward_text, renamed decode_forward (fixed upstream later);\n# alias it, then start the plugin's server (it forks, so SGLang's workers keep the alias)\nexec python -c 'import sys\nfrom models.tt_transformers.tt.generator import Generator\nGenerator.decode_forward_text = Generator.decode_forward\nfrom sglang_tt_plugin.scripts.launch_tt_server import main\nmain()' --model-path meta-llama/Llama-3.2-1B-Instruct --port 8000 --context-length 8192 --enable-metrics\n"
                ],
                "command": [
                    "bash",
                    "-c"
                ],
                "env": [
                    {
                        "name": "TORCHDYNAMO_DISABLE",
                        "value": "1"
                    },
                    {
                        "name": "HF_TOKEN",
                        "valueFrom": {
                            "secretKeyRef": {
                                "key": "token",
                                "name": "hf-token"
                            }
                        }
                    },
                    {
                        "name": "HOME",
                        "value": "/home/testuser"
                    }
                ],
                "image": "ghcr.io/tenstorrent/tt-inference-server/vllm-tt-metal-src-release-ubuntu-22.04-amd64:0.11.1-84b4c53-222ee06",
